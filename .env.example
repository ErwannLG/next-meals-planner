# Database
DATABASE_URL="postgresql://user:password@localhost:5432/meals_planner"
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/meals_planner_shadow"

# Clerk Authentication
# Get your keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk URLs (optional - defaults provided)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# App URL (optional - used for API calls in production)
# If not set, will use VERCEL_URL or localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
