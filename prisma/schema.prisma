// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl =  env("SHADOW_DATABASE_URL")
}

model Season {
  id          Int         @id @default(autoincrement())
  name        String
  dishes      Dish[]      @relation("DishToSeason")
  vegetables  Vegetable[] @relation("VegetableToSeason")
}

model Dish {
  id          Int                   @id @default(autoincrement())
  name        String
  seasons     Season[]              @relation("DishToSeason")
  menuItems   MenuItem[]
  preferences UserDishPreference[]
}

model Vegetable {
  id          Int                       @id @default(autoincrement())
  name        String
  seasons     Season[]                  @relation("VegetableToSeason")
  menuItems   MenuItem[]
  preferences UserVegetablePreference[]
}

model MenuHistory {
  id           Int        @id @default(autoincrement())
  userId       String
  validatedAt  DateTime   @default(now())
  numberOfDays Int
  items        MenuItem[]

  @@index([userId])
}

model MenuItem {
  id            Int         @id @default(autoincrement())
  menuHistory   MenuHistory @relation(fields: [menuHistoryId], references: [id], onDelete: Cascade)
  menuHistoryId Int
  dayNumber     Int
  dishId        Int
  vegetableId   Int
  dish          Dish        @relation(fields: [dishId], references: [id])
  vegetable     Vegetable   @relation(fields: [vegetableId], references: [id])
}

model UserDishPreference {
  id        Int            @id @default(autoincrement())
  userId    String
  dishId    Int
  type      PreferenceType
  createdAt DateTime       @default(now())
  dish      Dish           @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([userId, dishId])
  @@index([userId])
}

model UserVegetablePreference {
  id         Int            @id @default(autoincrement())
  userId     String
  vegetableId Int
  type       PreferenceType
  createdAt  DateTime       @default(now())
  vegetable  Vegetable      @relation(fields: [vegetableId], references: [id], onDelete: Cascade)

  @@unique([userId, vegetableId])
  @@index([userId])
}

enum PreferenceType {
  FAVORITE
  DISLIKED
}
